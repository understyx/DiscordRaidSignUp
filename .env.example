# Discord Bot
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id
DISCORD_CLIENT_SECRET=your_client_secret

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=raidbot
DB_PASSWORD=changeme
DB_NAME=raidbot

# Web
WEB_SECRET_KEY=change_this_to_a_random_string
WEB_BASE_URL=http://localhost:8000
DISCORD_REDIRECT_URI=http://localhost:8000/auth/callback
RECRUITMENT_DISCORD_REDIRECT_URI=http://localhost:8000/recruitment/oauth-callback

# Subdomain support (optional)
# Set BASE_DOMAIN to your root domain so guilds can use <slug>.example.com.
# Set COOKIE_DOMAIN to the dot-prefixed root domain so the session cookie is
# shared across all subdomains (e.g. ".example.com").
# Leave both unset when running locally or without subdomain support.
BASE_DOMAIN=
COOKIE_DOMAIN=

# Disposable demo guild at demo.<BASE_DOMAIN>. Data is regenerated on startup
# and at this interval. The IDs must fit in a signed BIGINT.
DEMO_GUILD_ENABLED=true
DEMO_GUILD_ID=-1
DEMO_GUILD_NAME=Demo Guild
DEMO_RESET_INTERVAL_MINUTES=30

# Officer role name (Discord role that can manage raids)
OFFICER_ROLE_NAME=Officer

# Developer user ID — Discord user ID of the developer/admin account.
# This user can access the /admin/spec-aliases page to manage spec alias mappings.
# Find your user ID by enabling Developer Mode in Discord, then right-clicking your profile → Copy ID.
DEV_USER_ID=your_discord_user_id_here

# Developer full admin override.
# When true, the DEV_USER_ID account is treated as raid-admin in every guild/server on the website.
# This can also be toggled live from the Dev Tools dropdown at runtime.
DEV_FULL_ADMIN=false

# Developer mode — enables seeding fake players into raids for UI testing
# Set to "true" to show the 🧪 Seed Fake Signups button on the manage page
DEV_MODE=false
