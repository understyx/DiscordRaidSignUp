[Unit]
Description=Discord Raid Sign-Up Web Server
After=network-online.target mysql.service mariadb.service
Wants=network-online.target

[Service]
Type=simple
# Change User/Group to whichever system user owns the app files
User=raidbot
Group=raidbot
WorkingDirectory=/opt/DiscordRaidSignUp/web
EnvironmentFile=/opt/DiscordRaidSignUp/.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=discord-raid-web

[Install]
WantedBy=multi-user.target
