{
  "name": "raid-signup-web",
  "version": "1.0.0",
  "description": "WoW Raid Sign-Up web server",
  "main": "server.js",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "start": "node server.js",
    "migrate": "node migrate-cli.js",
    "test": "node --test test/*.test.js",
    "lint": "eslint --ext .js .",
    "format": "prettier --write \"**/*.{js,json}\"",
    "format:check": "prettier --check \"**/*.{js,json}\""
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.18.1",
    "mysql2": "^3.11.5",
    "node-fetch": "^2.7.0",
    "nunjucks": "^3.2.4"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "eslint": "9.33.0",
    "prettier": "3.6.2"
  }
}
